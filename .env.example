# Development profile; production additionally requires PostgreSQL, HTTPS object storage,
# a non-fake provider API key, and RAG_DEBUG=false.
RAG_PLATFORM_PROFILE=development
RAG_DATABASE_URL=postgresql+psycopg://ragqs:ragqs@localhost:5432/ragqs
RAG_DATABASE_POOL_SIZE=5
RAG_DATABASE_CONNECT_TIMEOUT_SECONDS=5

RAG_OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
RAG_OBJECT_STORAGE_BUCKET=ragqs
RAG_OBJECT_STORAGE_ACCESS_KEY=minioadmin
RAG_OBJECT_STORAGE_SECRET_KEY=change-me

RAG_PROVIDER_NAME=fake
# Optional for a non-fake provider or OpenAI-compatible endpoint.
# RAG_PROVIDER_API_KEY=
# RAG_PROVIDER_BASE_URL=
RAG_LOG_LEVEL=INFO
RAG_INDEX_NAMESPACE=default
RAG_INDEX_SPARSE_PROVIDER=meilisearch
RAG_INDEX_RERANKER_PROVIDER=configured
RAG_INDEX_IMAGE_VLM_PROVIDER=configured
RAG_INDEX_IMAGE_VLM_CREDENTIAL_REF=image-vlm
# bailian: OpenAI-compatible qwen-vl endpoint; internvl: customer deployment profile.
# RAG_INDEX_IMAGE_VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# RAG_INDEX_IMAGE_VLM_API_KEY=
# RAG_INDEX_IMAGE_VLM_MODEL=qwen-vl-plus
# RAG_INDEX_IMAGE_VLM_REVISION=
RAG_INDEX_IMAGE_VLM_TIMEOUT_SECONDS=60
RAG_INDEX_GENERATION_ROLLBACK_DAYS=7
# Dev defaults to in-memory dense/sparse/embedding. Point these at docker-compose.yml
# to use real Milvus + Meilisearch + an OpenAI-compatible embedding endpoint.
RAG_INDEX_EMBEDDING_PROVIDER=memory
# RAG_INDEX_EMBEDDING_PROVIDER=openai-compatible
# RAG_INDEX_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# RAG_INDEX_EMBEDDING_API_KEY=
# RAG_INDEX_EMBEDDING_MODEL=text-embedding-v4
# RAG_INDEX_EMBEDDING_REVISION=text-embedding-v4
# RAG_INDEX_EMBEDDING_DIMENSION=1024
# RAG_INDEX_EMBEDDING_METRIC=cosine
RAG_INDEX_VECTOR_PROVIDER=memory
# RAG_INDEX_VECTOR_PROVIDER=milvus
# REST v2 shares the gRPC port (compose maps 19530); 9091 is metrics only.
# RAG_INDEX_VECTOR_URI=http://127.0.0.1:19530
# RAG_INDEX_VECTOR_TOKEN=
# RAG_INDEX_VECTOR_COLLECTION_PREFIX=ragqs
# RAG_INDEX_SPARSE_URL=http://127.0.0.1:7700
# RAG_INDEX_SPARSE_API_KEY=ragqs-dev-meili-key
# RAG_INDEX_SPARSE_INDEX=ragqs_chunks
# RAG_INDEX_SPARSE_DATA_PATH=./volumes/meilisearch
# Optional OpenSearch + IK startup profile. TLS, credentials, JVM heap, IK,
# and the actual Chinese analyzer probe must all pass before the app starts.
# RAG_INDEX_SPARSE_PROVIDER=opensearch+ik
# RAG_INDEX_SPARSE_URL=https://127.0.0.1:9200
# RAG_INDEX_SPARSE_USERNAME=admin
# RAG_INDEX_SPARSE_PASSWORD=
# RAG_INDEX_SPARSE_CA_PATH=./volumes/opensearch/ca.crt
# RAG_INDEX_SPARSE_JVM_HEAP_MIN_GB=1
# Text chunks are capped at 8,000 characters; a single XLSX merged region is capped at
# 10,000 cells during parsing.
RAG_INDEX_TEXT_CHUNK_MAX_CHARS=8000
RAG_INDEX_XLSX_MERGED_CELLS_MAX=10000
# OCR confidence threshold below which a page/chunk is flagged low confidence.
RAG_INDEX_OCR_CONFIDENCE_THRESHOLD=0.9
# MinerU document pipeline transport: disabled keeps the development callback unset;
# local runs the real `mineru` CLI with forced pipeline backend.
RAG_INDEX_MINERU_PROVIDER=disabled
RAG_INDEX_MINERU_EXECUTABLE=mineru
RAG_INDEX_MINERU_TIMEOUT_SECONDS=900
# Contextual Retrieval uses the fixed ds-v4-flash model; disabled keeps the
# development/test processor without provider calls.
RAG_INDEX_CONTEXTUAL_RETRIEVAL_PROVIDER=disabled
# RAG_INDEX_CONTEXTUAL_RETRIEVAL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# RAG_INDEX_CONTEXTUAL_RETRIEVAL_API_KEY=
RAG_INDEX_CONTEXTUAL_RETRIEVAL_MODEL=ds-v4-flash
RAG_INDEX_CONTEXTUAL_RETRIEVAL_REVISION=ds-v4-flash
RAG_INDEX_CONTEXTUAL_RETRIEVAL_TIMEOUT_SECONDS=60
RAG_INDEX_CONTEXTUAL_RETRIEVAL_CONCURRENCY=4
RAG_INDEX_CONTEXTUAL_RETRIEVAL_PREFIX_TOKEN_LIMIT=30000
RAG_INDEX_CONTEXTUAL_PREFIX_CACHE_PROVIDER=memory
# Per-file upload limit is 25 MiB. Cleanup targets stop automatic retries after three
# failures and retain their final error state.
RAG_DOCUMENTS_UPLOAD_MAX_BYTES=26214400
RAG_DOCUMENTS_CLEANUP_MAX_ATTEMPTS=3

# Per-effort logical RAG operation caps (quick/think/deep). Deployment-level
# configuration; changes apply to new generations after a restart.
RAG_EFFORT_RAG_CALL_LIMIT_QUICK=1
RAG_EFFORT_RAG_CALL_LIMIT_THINK=8
RAG_EFFORT_RAG_CALL_LIMIT_DEEP=10

# 「优化输入」（POST /v1/prompt-enhancements）：模型名为平台固定值；密钥与地址复用
# 全局 RAG_PROVIDER_API_KEY/RAG_PROVIDER_BASE_URL（缺省指向 DashScope 兼容端点），
# 未配置密钥时端点以 503 fail-closed。
# RAG_CHAT_ENHANCE_MODEL=qwen3.7-plus
RAG_CHAT_ENHANCE_TIMEOUT_SECONDS=30
RAG_CHAT_ENHANCE_MAX_PROMPT_CHARS=4000

# Optional evaluation lane configuration.
RAG_EVALUATION_JUDGE_CREDENTIAL_REF=judge
# RAG_EVALUATION_JUDGE_BASE_URL=
# RAG_EVALUATION_JUDGE_API_KEY=
RAG_EVALUATION_CANDIDATE_CONFIGS=default

# IANA timezone name; production must set it explicitly (UTC is allowed).
RAG_BUSINESS_TIMEZONE=Asia/Shanghai
# Required for the protected usage-maintenance CLI (ragqs-usage-maintenance) invoked by
# external CronJob; never pass as an argument and never log it.
# RAG_MAINTENANCE_KEY=
RAG_WORKER_CONCURRENCY=1
RAG_WORKER_LEASE_SECONDS=60
# Resident backup maintenance worker (ragqs-backup-maintenance): schedule poll
# interval, write-gate settle/drain protocol timings and retention batch size.
RAG_BACKUP_SCHEDULE_INTERVAL_SECONDS=60
RAG_BACKUP_GATE_SETTLE_SECONDS=2
RAG_BACKUP_GATE_DRAIN_TIMEOUT_SECONDS=30
RAG_BACKUP_RETENTION_BATCH_LIMIT=50
RAG_OBSERVABILITY_API_METRIC_RETENTION_DAYS=90
RAG_OBSERVABILITY_SUCCESS_SAMPLE_RATE=0.1
RAG_OBSERVABILITY_MAX_ROUTE_TEMPLATES=100
# Positive day counts. Retention is snapshotted when a notification is materialized or
# a delivery reaches delivered; later changes do not recalculate existing deadlines.
RAG_OUTBOX_NOTIFICATION_RETENTION_DAYS=90
RAG_OUTBOX_DELIVERED_RETENTION_DAYS=30

# Identity session policy. Production additionally requires a secret, allowed origins,
# and at least one administrator in the roster.
RAG_AUTH_ACCESS_TTL_SECONDS=900
RAG_AUTH_REFRESH_TTL_SECONDS=604800
RAG_AUTH_REFRESH_REUSE_GRACE_SECONDS=5
RAG_AUTH_LOGIN_MAX_ATTEMPTS=5
# Optional explicit cookie Secure policy. Omit to derive from profile
# (production=true, development=false).
# RAG_AUTH_COOKIE_SECURE=
RAG_AUTH_LOGIN_LOCK_SECONDS=60
# USER_DELETION_RETENTION_DAYS=30
# 账号删除归档包目录（生产必填：绝对路径、后端可写、且不在 Web 静态/上传等业务可读目录）
# USER_DELETION_ARCHIVE_DIR=/var/lib/ragqs/user-deletion-archives
# RAG_AUTH_SECRET_KEY=
# RAG_AUTH_ALLOWED_ORIGINS=
# RAG_AUTH_ADMIN_ROSTER=
RAG_DEBUG=false

# One-shot deployment bootstrap Job only. Do not inject these values into API or worker workloads.
# RAG_AUTH_BOOTSTRAP_USERNAME=
# RAG_AUTH_BOOTSTRAP_PASSWORD=
# RAG_AUTH_BOOTSTRAP_REAL_NAME=
# RAG_AUTH_BOOTSTRAP_DISPLAY_NAME=
