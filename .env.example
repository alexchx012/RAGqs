# Development profile; production additionally requires PostgreSQL, HTTPS object storage,
# a non-fake provider API key, and RAG_DEBUG=false.
RAG_PLATFORM_PROFILE=development
RAG_DATABASE_URL=postgresql+psycopg://ragqs:ragqs@localhost:5432/ragqs
RAG_DATABASE_POOL_SIZE=5
RAG_DATABASE_CONNECT_TIMEOUT_SECONDS=5

RAG_OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
RAG_OBJECT_STORAGE_BUCKET=ragqs
RAG_OBJECT_STORAGE_ACCESS_KEY=minioadmin
RAG_OBJECT_STORAGE_SECRET_KEY=change-me

RAG_PROVIDER_NAME=fake
RAG_LOG_LEVEL=INFO
RAG_INDEX_NAMESPACE=default
# IANA timezone name; production must set it explicitly (UTC is allowed).
RAG_BUSINESS_TIMEZONE=Asia/Shanghai
# Required for the protected usage-maintenance CLI (ragqs-usage-maintenance) invoked by
# external CronJob; never pass as an argument and never log it.
# RAG_MAINTENANCE_KEY=
RAG_WORKER_CONCURRENCY=1
RAG_WORKER_LEASE_SECONDS=60
RAG_OBSERVABILITY_API_METRIC_RETENTION_DAYS=90
RAG_OBSERVABILITY_SUCCESS_SAMPLE_RATE=0.1
RAG_OBSERVABILITY_MAX_ROUTE_TEMPLATES=100
# Positive day counts. Retention is snapshotted when a notification is materialized or
# a delivery reaches delivered; later changes do not recalculate existing deadlines.
RAG_OUTBOX_NOTIFICATION_RETENTION_DAYS=90
RAG_OUTBOX_DELIVERED_RETENTION_DAYS=30
RAG_DEBUG=false

# One-shot deployment bootstrap Job only. Do not inject these values into API or worker workloads.
# RAG_AUTH_BOOTSTRAP_USERNAME=
# RAG_AUTH_BOOTSTRAP_PASSWORD=
# RAG_AUTH_BOOTSTRAP_REAL_NAME=
# RAG_AUTH_BOOTSTRAP_DISPLAY_NAME=
